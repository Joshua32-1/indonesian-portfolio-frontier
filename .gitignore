# Monorepo root .gitignore

# Dependency directories
**/node_modules/
**/.pnpm-store/

# Build output
**/dist/
**/build/

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Env files (never commit secrets)
**/.env
**/.env.local
**/.env.*.local

# Vite cache
**/.vite/
