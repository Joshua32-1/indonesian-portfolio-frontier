{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix workbench",
  "buildCommand": "npm run build --prefix workbench",
  "outputDirectory": "workbench/dist",
  "functions": {
    "api/*.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/)(?!.*\\.).*)", "destination": "/index.html" }
  ]
}
